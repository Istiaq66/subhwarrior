<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors PrayerTimeCard's non-highlighted gradient (colorScheme.primary ->
     AppColorsX.brandGradientEnd, topStart -> bottomEnd) and 12dp corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#0F5233"
        android:endColor="#2A7F58" />
</shape>
