<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Fajr widget (FajrCompactWidgetProvider) — a separate, always-
     available picker entry, matching Sadiq's pattern of shipping distinct
     fixed widgets rather than one size-adaptive widget. minHeight matches
     the layout's actual wrap_content height (no dead space); resizeMode
     is horizontal-only — content doesn't grow taller, only wider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="125dp"
    android:minResizeWidth="90dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/fajr_widget_compact"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />